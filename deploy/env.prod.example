# DevInsight — production environment (VPS, Docker).
#
# Copy this file to deploy/.env.prod and fill it in:
#     cp deploy/env.prod.example deploy/.env.prod
# deploy/.env.prod is gitignored. It is used BOTH for docker compose variable
# substitution (--env-file) AND injected into the api / mcp / gateway containers.

# =====================================================================
# REQUIRED — the app will not boot without these.
# =====================================================================

# Neon (or any Postgres) connection string. Neon needs SSL, so keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ⚠️ Because you are keeping the SAME Neon database, these two MUST be the exact
# values already in your current apps/api/.env — otherwise existing JWTs are
# rejected and previously-encrypted integration secrets can no longer be decrypted.
JWT_ACCESS_SECRET="copy-the-same-value-from-apps/api/.env"
GIT_TOKEN_ENCRYPTION_KEY="copy-the-same-base64-32-byte-key-from-apps/api/.env"

# =====================================================================
# NETWORKING
# =====================================================================

# Baked into the web bundle at build time. Leave EMPTY: the browser then calls
# the API same-origin ("/api/...") and nginx routes it to the api container.
# (Only set an absolute URL if you serve the API on a different host.)
NEXT_PUBLIC_API_URL=""

# =====================================================================
# OPTIONAL — features degrade gracefully when unset.
# =====================================================================

# --- Report writer: paid Z.AI Coding Plan through its OpenAI-compatible API. ---
# OPENAI_API_KEY and ZAI_API_KEY below contain the same Z.AI key. The names are
# separate because the API report writer and OpenClaw use different adapters.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.z.ai/api/coding/paas/v4"
OPENAI_MODEL="glm-5.2"

# --- OpenClaw AI chat (only needed with the `openclaw` compose profile) ---
# After creating .env.prod, run the one-off secret rotation container documented
# in docs/OPENCLAW_SETUP.md; it replaces these values without printing them.
OPENCLAW_SERVICE_KEY=""
OPENCLAW_CONTEXT_SIGNING_SECRET=""
MCP_ACCESS_TOKEN=""
# The gateway is reachable inside the compose network at http://openclaw-gateway:18789
OPENCLAW_GATEWAY_URL="http://openclaw-gateway:18789"
OPENCLAW_GATEWAY_TOKEN=""
# OpenClaw's official Z.AI provider reads this key directly.
ZAI_API_KEY=""
# Optional inactive fallback credential. Production defaults to Z.AI/GLM-5.2.
GROQ_API_KEY=""
# Optional image override. Pin a tested release/digest here when desired.
OPENCLAW_IMAGE="ghcr.io/openclaw/openclaw:latest"

# --- GitHub App (customer repository connection). Optional. ---
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""

# Automatic retry for transient GitHub Actions failures. The GitHub App must
# subscribe to workflow_run events and have Actions: write permission.
CI_AUTO_RETRY_ENABLED="false"
CI_AUTO_RETRY_QUEUE_INTERVAL_MS="5000"
CI_AUTO_RETRY_POLL_INTERVAL_MS="120000"
CI_AUTO_RETRY_MAX_REPOSITORIES_PER_POLL="25"

# --- Code quality (only needed with the `sonar` compose profile) ---
CODE_QUALITY_PROVIDER="sonarqube"
# How the API talks to SonarQube inside the compose network. SonarQube runs under
# the /sonarqube context path (SONAR_WEB_CONTEXT in docker-compose.prod.yml), so
# include it here too — otherwise the API's requests 404.
SONAR_BASE_URL="http://sonarqube:9000/sonarqube"
# Admin/create-project-capable token (My Account -> Security in SonarQube) —
# provisioning needs it to create projects + mint per-repo analysis tokens.
SONAR_TOKEN=""
SONAR_ORGANIZATION=""
# Externally reachable SonarQube URL for MULTI-TENANT auto-scan: the one a client
# repo's GitHub Actions runner uses to push results (over the internet). Set this
# to enable "Enable scan" per repo. Prefer HTTPS via nginx (see deploy/nginx.conf
# `/sonarqube/`) so the injected analysis token isn't sent in clear text.
SONAR_PUBLIC_URL="https://your-domain/sonarqube"
# Password for the bundled SonarQube Postgres (sonar profile). Change it.
SONAR_DB_PASSWORD="sonar"
