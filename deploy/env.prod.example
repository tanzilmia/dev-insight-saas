# DevInsight — production environment (VPS, Docker).
#
# Copy this file to deploy/.env.prod and fill it in:
#     cp deploy/env.prod.example deploy/.env.prod
# deploy/.env.prod is gitignored. It is used BOTH for docker compose variable
# substitution (--env-file) AND injected into the api / mcp / gateway containers.

# =====================================================================
# REQUIRED — the app will not boot without these.
# =====================================================================

# Neon (or any Postgres) connection string. Neon needs SSL, so keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ⚠️ Because you are keeping the SAME Neon database, these two MUST be the exact
# values already in your current apps/api/.env — otherwise existing JWTs are
# rejected and previously-encrypted Git PATs can no longer be decrypted.
JWT_ACCESS_SECRET="copy-the-same-value-from-apps/api/.env"
GIT_TOKEN_ENCRYPTION_KEY="copy-the-same-base64-32-byte-key-from-apps/api/.env"

# =====================================================================
# NETWORKING
# =====================================================================

# Baked into the web bundle at build time. Leave EMPTY: the browser then calls
# the API same-origin ("/api/...") and Caddy routes it to the api container.
# (Only set an absolute URL if you serve the API on a different host.)
NEXT_PUBLIC_API_URL=""

# Public URL GitHub can reach this API at, for live-sync webhook registration.
# With no domain yet, use your VPS IP. Leave empty to disable live sync cleanly.
#   PUBLIC_API_URL="http://YOUR_VPS_IP"
PUBLIC_API_URL=""

# =====================================================================
# OPTIONAL — features degrade gracefully when unset.
# =====================================================================

# --- LLM (any OpenAI-compatible endpoint). No key => reports use a template. ---
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_MODEL="llama-3.3-70b-versatile"

# --- OpenClaw AI chat (only needed with the `openclaw` compose profile) ---
OPENCLAW_SERVICE_KEY=""
OPENCLAW_CONTEXT_SIGNING_SECRET=""
MCP_ACCESS_TOKEN=""
# The gateway is reachable inside the compose network at http://openclaw-gateway:18789
OPENCLAW_GATEWAY_URL=""
OPENCLAW_GATEWAY_TOKEN=""

# --- GitHub App (customer repository connection). Optional. ---
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""

# --- Code quality (only needed with the `sonar` compose profile) ---
CODE_QUALITY_PROVIDER="sonarqube"
# Inside the compose network SonarQube is reachable at http://sonarqube:9000.
SONAR_BASE_URL="http://sonarqube:9000"
SONAR_TOKEN=""
SONAR_ORGANIZATION=""
# Password for the bundled SonarQube Postgres (sonar profile). Change it.
SONAR_DB_PASSWORD="sonar"
