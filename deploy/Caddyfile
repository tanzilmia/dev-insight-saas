# DevInsight reverse proxy — single origin, HTTP only (no domain yet).
#
# Everything is served from one host on port 80:
#   /api/*   -> api container   (Express, incl. /api/webhooks/* for GitHub)
#   /*       -> web container   (Next.js)
#
# Because the browser reaches the API on the SAME origin as the web app, the web
# image is built with NEXT_PUBLIC_API_URL="" (relative "/api/..." calls). Nothing
# here needs the VPS IP, so there is nothing to change when the IP changes.
#
# When you later get a domain + HTTPS, replace `:80` with `yourdomain.com`,
# delete the `auto_https off` line, and Caddy will obtain a Let's Encrypt cert
# automatically (ports 80 + 443 must be open).

{
	# No domain -> we serve plain HTTP on an IP, so disable automatic HTTPS.
	auto_https off
}

:80 {
	encode gzip

	# API + webhooks -> Express. The path is preserved (no strip), because the
	# API mounts its routes under /api/*.
	@api path /api/*
	handle @api {
		reverse_proxy api:4000
	}

	# Everything else -> the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}
