{
  "name": "dev-insight-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./start-dev.sh",
    "dev:web": "npm run dev -w @devinsight/web",
    "dev:api": "npm run dev -w @devinsight/api",
    "dev:mcp": "cd integrations/devinsight-mcp-server && ./run.sh",
    "docker:up": "docker compose up -d sonar_db sonarqube openclaw-gateway",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps",
    "docker:openclaw:cli": "docker compose run --rm openclaw-cli",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "security:rotate-local-secrets": "node scripts/rotate-local-security-secrets.mjs",
    "security:sync-openclaw-mcp-token": "node scripts/sync-openclaw-mcp-token.mjs",
    "prisma:generate": "npm run prisma:generate -w @devinsight/api"
  },
  "engines": {
    "node": ">=20"
  }
}
