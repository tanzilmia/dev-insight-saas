{
  "name": "dev-insight-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @devinsight/web",
    "dev:api": "npm run dev -w @devinsight/api",
    "dev:mcp": "cd integrations/devinsight-mcp-server && ./run.sh",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @devinsight/api"
  },
  "engines": {
    "node": ">=20"
  }
}

