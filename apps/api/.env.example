PORT=4000
DATABASE_URL="postgresql://devinsight:devinsight@localhost:5432/devinsight?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
GIT_TOKEN_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"


# --- Optional integrations (features degrade gracefully when unset) ---
# LLM (any OpenAI-compatible endpoint). No key => reports use a template.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
# OpenClaw chat integration.
# OPENCLAW_SERVICE_KEY=""
# OPENCLAW_GATEWAY_URL="http://localhost:18789"
# OPENCLAW_GATEWAY_TOKEN=""
# Live sync (GitHub webhooks): the public URL GitHub can reach this API at.
# Required for webhook auto-registration; leave unset on localhost.
# PUBLIC_API_URL="https://api.yourdomain.com"

# --- GitHub App (customer repository connection) ---
# The DevInside owner registers ONE GitHub App and fills these in. Until set,
# the App connection UI shows a "not available yet" state and every App endpoint
# returns 503 GITHUB_APP_NOT_CONFIGURED — nothing else is affected.
# See docs/architecture/github-app-foundation.md for the full setup guide.
# GITHUB_APP_ID="123456"
# The App's URL slug (github.com/apps/<slug>), used to build the install link.
# GITHUB_APP_SLUG="devinside"
# GITHUB_APP_CLIENT_ID="Iv1.xxxxxxxxxxxxxxxx"
# The App's RSA private key. Recommended: base64-encode the downloaded .pem
#   (`base64 -i devinside.private-key.pem`) to keep it on a single line.
# GITHUB_APP_PRIVATE_KEY="LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQ..."
# The webhook secret you set when creating the App (verifies App deliveries).
# GITHUB_APP_WEBHOOK_SECRET="replace-with-a-long-random-secret"
