generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  MANAGER
  EMPLOYEE
  ADMIN
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  LEAD
  DEVELOPER
  REVIEWER
}

enum GitProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum ScheduleCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum CollectionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SnapshotGranularity {
  DAILY
  WEEKLY
  MONTHLY
}

enum AwardStatus {
  SHORTLISTED
  CONFIRMED
  DISMISSED
}

enum ChannelType {
  TELEGRAM
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships        OrganizationMember[]
  projectMemberships ProjectMember[]
  gitMappings        EmployeeGitMapping[]
  gitAliases         EmployeeGitAlias[]
  reportsRequested   Report[]             @relation("ReportsRequested")
  reportSchedules    ReportSchedule[]     @relation("ScheduleCreator")
  collectionJobs     CollectionJob[]      @relation("CollectionJobsRequested")
  requestLogs        RequestLog[]
  auditLogs          AuditLog[]           @relation("AuditActor")

  @@index([status])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               OrganizationMember[]
  projects              Project[]
  repositories          Repository[]
  contributorIdentities ContributorIdentity[]
  gitMappings           EmployeeGitMapping[]
  gitAliases            EmployeeGitAlias[]
  reports               Report[]
  reportSchedules       ReportSchedule[]
  collectionJobs        CollectionJob[]
  leaderboardSnapshots  LeaderboardSnapshot[]
  employeeAwards        EmployeeAward[]
  notificationChannels  NotificationChannel[]
  githubAppInstallations GitHubAppInstallation[]
  ciConfigurations      CiConfiguration[]
  workflowRuns          WorkflowRun[]
  codeQualityConnection CodeQualityConnection?
  codeQualitySnapshots  CodeQualitySnapshot[]
  requestLogs           RequestLog[]
  auditLogs             AuditLog[]
}

/// Per-org SonarQube/SonarCloud connection. The analysis token is AES-256-GCM
/// encrypted at rest with token-cipher and never returned to the client.
/// One per organization; absent → the env fallback (local dev) applies.
model CodeQualityConnection {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  provider        String   @default("sonarqube") // "sonarqube" | "sonarcloud"
  baseUrl         String
  tokenCipher     String
  organizationKey String? // set for SonarCloud (enables branch/PR capabilities)
  status          String? // last test result: "OK" | "INVALID" | "UNREACHABLE"
  lastCheckedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// A pull request, for collaboration/review metrics (who opens, who merges, who
/// reviews — work that never shows up in commit counts). Fetched from the git
/// provider and de-duplicated by [repositoryId, number].
model PullRequest {
  id           String   @id @default(cuid())
  repositoryId String
  number       Int
  title        String
  authorLogin  String?
  state        String // "open" | "closed"
  merged       Boolean  @default(false)
  additions    Int?
  deletions    Int?
  changedFiles Int?
  openedAt     DateTime
  mergedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews    PullRequestReview[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([repositoryId, authorLogin])
}

/// A single review left on a pull request (the reviewer's contribution).
model PullRequestReview {
  id            String   @id @default(cuid())
  pullRequestId String
  externalId    String // provider review id
  reviewerLogin String?
  state         String // APPROVED | CHANGES_REQUESTED | COMMENTED | DISMISSED
  submittedAt   DateTime?
  createdAt     DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, externalId])
  @@index([pullRequestId])
  @@index([reviewerLogin])
}

/// One-per-day code-quality measurement for a SonarQube project, so trends
/// (coverage/bugs over time) can be shown. Idempotent via [org, projectKey, dayKey]
/// — the day's row is upserted to the latest capture.
model CodeQualitySnapshot {
  id                    String   @id @default(cuid())
  organizationId        String
  projectKey            String
  dayKey                String // local YYYY-MM-DD
  capturedAt            DateTime @default(now())
  bugs                  Int
  vulnerabilities       Int
  codeSmells            Int
  securityHotspots      Int
  coverage              Float?
  duplicatedLinesDensity Float?
  techDebtMinutes       Int?
  linesOfCode           Int?
  gateStatus            String // OK | ERROR | WARN | NONE
  reliabilityRating     String?
  securityRating        String?
  maintainabilityRating String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectKey, dayKey])
  @@index([organizationId, projectKey])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  repositories Repository[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Repository {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String?
  // GitHub App-only ownership: every repository belongs to one linked App
  // installation. Repository selection in GitHub is the source of truth.
  appInstallationId String
  provider       GitProvider @default(GITHUB)
  externalId     String
  owner          String
  name           String
  fullName       String
  remoteUrl      String
  isPrivate      Boolean     @default(false)
  defaultBranch  String?
  lastSyncedAt   DateTime?
  // The SonarQube/SonarCloud project key this repo is analyzed under (nullable —
  // set once code-quality scanning is wired for the repo). Lets appraisals/reports
  // map a repo to its static-analysis results.
  sonarProjectKey String?
  // Multi-tenant auto-scan provisioning: the per-project SonarQube analysis token
  // (AES-256-GCM encrypted at rest and never returned by any API), and
  // when the repo was provisioned (project created + token injected into the repo's
  // GitHub Actions secrets). Null → not provisioned for automated code-quality scans.
  sonarTokenCipher   String?
  sonarProvisionedAt DateTime?
  // App-wide signed push webhook health for this repository.
  webhookStatus     String?
  lastWebhookAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  appInstallation GitHubAppInstallation @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  access         RepositoryAccess[]
  ciConfiguration CiConfiguration?
  workflowRuns    WorkflowRun[]
  contributors   ContributorIdentity[]
  commits        Commit[]
  coverage       RepositoryCoverage[]
  branches       Branch[]
  collectionJobs CollectionJob[]
  pullRequests   PullRequest[]

  @@unique([organizationId, provider, externalId])
  @@index([organizationId])
  @@index([projectId])
  @@index([appInstallationId])
}

model ContributorIdentity {
  id             String      @id @default(cuid())
  organizationId String
  repositoryId   String
  provider       GitProvider @default(GITHUB)
  externalId     String
  username       String?
  authorName     String?
  authorEmail    String?
  avatarUrl      String?
  contributions  Int         @default(0)
  ignored        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  mapping      EmployeeGitMapping?

  @@unique([repositoryId, externalId])
  @@index([organizationId])
  @@index([repositoryId])
}

model EmployeeGitMapping {
  id                    String   @id @default(cuid())
  organizationId        String
  userId                String
  contributorIdentityId String   @unique
  isPrimary             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributorIdentity ContributorIdentity @relation(fields: [contributorIdentityId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

/**
 * A git identity an employee is *declared* to own, at org scope (not per-repo).
 * This is the source of truth for auto-mapping: when a repository's
 * contributors are discovered, any identity whose `username` matches an alias
 * here is linked to the employee automatically — for every repo, present and
 * future. An employee may own several aliases (multiple GitHub accounts /
 * emails). `username` is the high-confidence key that is auto-applied; `email`
 * and `name` are kept for secondary/suggested matching. Values are normalized
 * (lowercased/trimmed) on write.
 */
model EmployeeGitAlias {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  provider       GitProvider @default(GITHUB)
  username       String?
  email          String?
  name           String?
  isPrimary      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, username])
  @@index([organizationId, provider, username])
  @@index([organizationId, provider, email])
  @@index([userId])
}

model Commit {
  id                String   @id @default(cuid())
  repositoryId      String
  sha               String
  message           String
  authorName        String?
  authorEmail       String?
  username          String?
  committedAt       DateTime
  additions         Int      @default(0)
  deletions         Int      @default(0)
  changedFilesCount Int      @default(0)
  createdAt         DateTime @default(now())

  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  changedFiles ChangedFile[]
  branches     CommitBranch[]

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@index([repositoryId, username])
}

model ChangedFile {
  id        String  @id @default(cuid())
  commitId  String
  filePath  String
  status    String?
  additions Int     @default(0)
  deletions Int     @default(0)
  changes   Int     @default(0)

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId])
}

/**
 * Coverage ledger (Phase B): records which [rangeStart, rangeEnd] windows of a
 * repository's history have already been collected, per branch. Lets the report
 * engine (Phase C) decide whether a requested range is in the DB (serve locally)
 * or must be fetched from Git (collect only the missing sub-ranges). Intervals
 * for a (repository, branch) are kept merged/non-overlapping.
 */
model RepositoryCoverage {
  id           String   @id @default(cuid())
  repositoryId String
  branch       String
  rangeStart   DateTime
  rangeEnd     DateTime
  commitCount  Int      @default(0)
  collectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, branch])
}

/**
 * A branch of a repository (Phase D). Multi-branch collection lets reports show
 * in-progress (unmerged) work, not just what has landed on the default branch.
 */
model Branch {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  isDefault    Boolean  @default(false)
  headSha      String?
  isProtected  Boolean  @default(false)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  commits    CommitBranch[]

  @@unique([repositoryId, name])
  @@index([repositoryId])
}

/**
 * Join between a commit and the branches it is reachable from. A commit's SHA is
 * stored once (deduped) in Commit; this records every branch it appears on, so a
 * commit merged into several branches is not double-counted.
 */
model CommitBranch {
  commitId String
  branchId String

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([commitId, branchId])
  @@index([branchId])
}

/**
 * Phase E: a background deep-history collection job for one repository.
 * DB-backed so jobs survive restarts; claimed atomically by the collection
 * worker (same pattern as ReportSchedule) so multiple API instances never run
 * the same job. Progress is checkpointed via the coverage ledger, so a resumed
 * job re-plans only what is still missing. A partial unique index (raw SQL in
 * the migration) enforces at most one QUEUED/RUNNING job per repository.
 */
model CollectionJob {
  id             String              @id @default(cuid())
  organizationId String
  repositoryId   String
  requestedById  String?
  status         CollectionJobStatus @default(QUEUED)

  // Requested window (fixed at creation so progress totals stay stable).
  rangeStart DateTime
  rangeEnd   DateTime
  // Verify mode: re-list the entire range ignoring the coverage ledger, so
  // commits pushed after earlier collections (committer dates inside covered
  // ranges) are recovered. Sha-dedup keeps the cost bounded.
  verify     Boolean  @default(false)

  // Progress (updated by the worker per chunk / every few commits).
  branchesTotal    Int     @default(0)
  branchesDone     Int     @default(0)
  chunksTotal      Int     @default(0)
  chunksDone       Int     @default(0)
  commitsCollected Int     @default(0)
  currentBranch    String?
  currentPhase     String?

  // Worker bookkeeping.
  claimedBy         String?
  heartbeatAt       DateTime?
  attempts          Int       @default(0)
  resumeAt          DateTime?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation("CollectionJobsRequested", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, resumeAt])
  @@index([repositoryId, createdAt])
  @@index([organizationId, createdAt])
}

model Report {
  id              String   @id @default(cuid())
  organizationId  String
  requestedById   String?
  reportType      String
  targetLabel     String
  repositoryId    String?
  projectId       String?
  periodStart     DateTime
  periodEnd       DateTime
  title           String
  markdownContent String
  statisticsJson  Json?
  status          String
  generatedBy     String?
  dataFingerprint String?
  shareToken      String?  @unique
  createdAt       DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?               @relation("ReportsRequested", fields: [requestedById], references: [id], onDelete: SetNull)
  contributors ReportContributor[]

  @@index([organizationId, createdAt])
  @@index([organizationId, reportType])
  @@index([organizationId, reportType, dataFingerprint])
}

model ReportContributor {
  id                    String @id @default(cuid())
  reportId              String
  userId                String?
  contributorIdentityId String?
  name                  String?
  commitCount           Int    @default(0)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/**
 * A recurring report (Phase 14a). A background scheduler runs due schedules,
 * generates the report through OpenClaw orchestration, and records the result.
 */
model ReportSchedule {
  id             String          @id @default(cuid())
  organizationId String
  createdById    String?
  name           String
  reportType     String
  repositoryId   String?
  projectId      String?
  employeeIds    String[]
  period         String
  cadence        ScheduleCadence
  runHour        Int             @default(9)
  runMinute      Int             @default(0)
  timeZone       String?
  customPrompt   String?
  // Optional delivery target (Phase 14c). No FK — a snapshot id, tolerant of a
  // deleted channel (delivery is skipped if it no longer exists).
  channelId      String?
  enabled        Boolean         @default(true)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  lastReportId   String?
  lastStatus     String?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([enabled, nextRunAt])
}

// Phase 3a — a periodic snapshot of the contributor leaderboard for a scope
// (org-wide or a single project) over a completed day/week/month. Powers digest
// rank-deltas, streaks, and the employee-of-the-month period comparison.
model LeaderboardSnapshot {
  id             String              @id @default(cuid())
  organizationId String
  // "org" for the whole organization, otherwise the projectId. Non-null so the
  // unique constraint dedups reliably (a nullable projectId would let Postgres
  // treat two org-wide rows as distinct).
  scope          String
  projectName    String?
  granularity    SnapshotGranularity
  periodKey      String
  rangeStart     DateTime
  rangeEnd       DateTime
  totalCommits   Int                 @default(0)
  totalLines     Int                 @default(0)
  contributors   Int                 @default(0)
  generatedAt    DateTime            @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows         LeaderboardSnapshotRow[]

  @@unique([organizationId, scope, granularity, periodKey])
  @@index([organizationId, granularity, rangeStart])
}

model LeaderboardSnapshotRow {
  id           String   @id @default(cuid())
  snapshotId   String
  userId       String?
  name         String
  usernames    String[]
  rank         Int
  commits      Int      @default(0)
  additions    Int      @default(0)
  deletions    Int      @default(0)
  lines        Int      @default(0)
  filesChanged Int      @default(0)

  snapshot LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([userId])
}

// Phase 4b — an employee-of-the-month shortlist entry. The engine proposes
// SHORTLISTED rows (deterministic score + LLM/template citation); a manager
// confirms one → CONFIRMED (siblings in the same scope+period → DISMISSED).
model EmployeeAward {
  id             String      @id @default(cuid())
  organizationId String
  scope          String
  projectName    String?
  periodKey      String
  rangeStart     DateTime
  rangeEnd       DateTime
  userId         String?
  name           String
  usernames      String[]
  rank           Int
  score          Float       @default(0)
  commits        Int         @default(0)
  lines          Int         @default(0)
  activeDays     Int         @default(0)
  filesChanged   Int         @default(0)
  citation       String
  // Plain-language enrichment for non-technical readers: { projects, workType, areas }.
  detailsJson    Json?
  generatedBy    String?
  status         AwardStatus @default(SHORTLISTED)
  confirmedById  String?
  confirmedAt    DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, scope, periodKey])
  @@index([organizationId, status])
}

// Phase 14c — an admin-managed delivery destination (e.g. a Telegram group).
// Everything is stored here (not in env): the bot token is AES-256-GCM encrypted
// at rest with token-cipher and never returned to the frontend.
model NotificationChannel {
  id                 String      @id @default(cuid())
  organizationId     String
  type               ChannelType @default(TELEGRAM)
  label              String
  encryptedToken     String
  tokenLast4         String?
  chatId             String
  chatTitle          String?
  enabled            Boolean     @default(true)
  createdById        String?
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?
  lastDeliveryError  String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model RequestLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  source         String
  input          String?
  status         String
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/**
 * A GitHub App installation, linking a customer's GitHub account/organization to
 * a DevInside organization (tenant). The DevInside owner registers ONE App;
 * every customer installs it and approves repositories. No secret is stored
 * here: the App private key lives in env, and installation access tokens are
 * short-lived (~1h) and minted on demand — never persisted. `installationId`
 * (GitHub's numeric id) is globally unique, which is the cross-tenant guard:
 * one GitHub installation can belong to exactly one DevInside org.
 */
model GitHubAppInstallation {
  id                  String   @id @default(cuid())
  organizationId      String
  // GitHub's numeric installation id (stored as a string). Globally unique.
  installationId      String   @unique
  accountLogin        String
  // "User" | "Organization" — the kind of GitHub account the App is installed on.
  accountType         String?
  accountId           String?
  targetType          String?
  // "all" | "selected" — GitHub's repository_selection for this installation.
  repositorySelection String?
  permissions         Json?
  suspendedAt         DateTime?
  repositoryCount     Int      @default(0)
  createdById         String?
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositories Repository[]
  access       RepositoryAccess[]

  @@index([organizationId])
}

/**
 * Access grant: which repositories a GitHub App installation currently exposes
 * to DevInside. Distinct from Repository so revoking access (GitHub
 * `installation_repositories.removed`) deletes only the grant, never the
 * Repository row or its collected history.
 */
model RepositoryAccess {
  id                String   @id @default(cuid())
  appInstallationId String
  repositoryId      String
  createdAt         DateTime @default(now())

  installation GitHubAppInstallation @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)
  repository   Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([appInstallationId, repositoryId])
  @@index([repositoryId])
}

/**
 * Per-repository CI (GitHub Actions) management state. DevInside installs a
 * managed workflow via a pull request (never a direct push to the default
 * branch) and tracks the setup PR + template version here. The workflow file
 * lives in the customer's repo; this row is DevInside's management record.
 * Status: PENDING (PR open, awaiting merge) | ENABLED (workflow on default
 * branch) | DISABLED (management paused).
 */
model CiConfiguration {
  id                String    @id @default(cuid())
  organizationId    String
  repositoryId      String    @unique
  status            String    @default("PENDING")
  templateId        String?
  templateVersion   String?
  workflowPath      String?
  setupBranch       String?
  pullRequestNumber Int?
  pullRequestUrl    String?
  pullRequestState  String?
  workflowFileSha   String?
  enabledById       String?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/**
 * A GitHub Actions workflow run synced from GitHub for a managed repository.
 * Deduped per repository by the provider run id; powers the CI run history in
 * DevInside. Read-only mirror — DevInside never fabricates runs.
 */
model WorkflowRun {
  id             String    @id @default(cuid())
  organizationId String
  repositoryId   String
  runId          String
  workflowId     String?
  name           String?
  branch         String?
  headSha        String?
  event          String?
  status         String?
  conclusion     String?
  actor          String?
  url            String?
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, runId])
  @@index([repositoryId, startedAt])
}
